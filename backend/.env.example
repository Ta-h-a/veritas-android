# Server Configuration
PORT=8080

# MongoDB Configuration
# Default matches docker-compose credentials
MONGO_URI=mongodb://admin:admin123@localhost:27017/veritas?authSource=admin
# Or use MongoDB Atlas
# MONGO_URI=mongodb+srv://username:password@cluster.mongodb.net/veritas?retryWrites=true&w=majority

# MEGA Storage Configuration
MEGA_EMAIL=your-mega-email@example.com
MEGA_PASSWORD=your-mega-password

# Mongoose Encryption Keys (Database-level encryption - Second layer)
# Generate encryption key (32 bytes): node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Generate signing key (64 bytes): node -e "console.log(require('crypto').randomBytes(64).toString('base64'))"
ENCRYPTION_KEY=your-base64-encoded-32-byte-encryption-key-here
SIGNING_KEY=your-base64-encoded-64-byte-signing-key-here

# Client-Side Encryption Key (First layer - must match frontend)
# Generate using: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
CLIENT_ENCRYPTION_KEY=your-base64-encoded-32-byte-client-key-here

# Environment
NODE_ENV=development